				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"user\": 2,\n  \"message\": \"Reminder for user 2\",\n  \"notify_date\": \"{{today}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/notifications/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications",
						""
					]
				}
			},
			"response": []
		},
