						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/notifications/unread_count/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications",
						"unread_count",
						""
					]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set collection variable 'today' to current date (YYYY-MM-DD)",
					"const d = new Date().toISOString().slice(0,10);",
					"pm.collectionVariables.set('today', d);"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "today",
			"value": "2026-01-03"
		},
		{
			"key": "user_id",
			"value": "2"
		}
