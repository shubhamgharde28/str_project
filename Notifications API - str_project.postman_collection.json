				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/notifications/mark_all_read/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications",
						"mark_all_read",
						""
					]
				}
			},
			"response": []
