						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/notifications/user/{{user_id}}/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications",
