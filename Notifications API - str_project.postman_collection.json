						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"message\": \"My personal reminder\",\n  \"notify_date\": \"{{today}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/notifications/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications",
						""
					]
				}
			},
			"response": []
