  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set collection variable 'today' to current date (YYYY-MM-DD)",
          "const d = new Date().toISOString().slice(0,10);",
          "pm.collectionVariables.set('today', d);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"password\": \"<password>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
