{
  "info": {
    "_postman_id": "a1b2c3d4-5678-90ab-cdef-1234567890ab",
    "name": "STR Project - Attendance & Notifications APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
