                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/user/{{user_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                "user",
                "{{user_id}}",
                ""
              ]
            },
            "description": "Superuser can query any user; regular users can only view their own"
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
