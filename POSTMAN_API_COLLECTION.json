            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<email>\",\n  \"password\": \"<password>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ATTENDANCE - CHECK-IN/OUT",
      "item": [
        {
          "name": "Check-In (Updated - Half-Day Logic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": \"28.6139\",\n  \"longitude\": \"77.2090\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/attendance/check-in/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                "check-in",
                ""
              ]
            },
            "description": "Check-in endpoint with new half-day logic:\n- Deadline: 10:45 AM (Grace period: 10:30 AM - 10:45 AM)\n- If check-in after 10:45 AM: is_half_day = true\n- Response includes: check_in_time, is_half_day field"
          }
        },
        {
          "name": "Check-Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": \"28.6139\",\n  \"longitude\": \"77.2090\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/attendance/check-out/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                "check-out",
                ""
              ]
            }
          }
        },
        {
          "name": "Monthly Attendance Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/attendance/summary/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                "summary",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "NOTIFICATIONS",
      "item": [
        {
          "name": "List Notifications (Today - Unread)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/?notify_date={{today}}&is_read=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                ""
              ],
              "query": [
                {
                  "key": "notify_date",
                  "value": "{{today}}"
                },
                {
                  "key": "is_read",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "List All Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notifications",
                ""
              ]
            }
          }
        },
        {
          "name": "Get User Notifications (by User ID)",
          "request": {
            "method": "GET",
            "header": [
